# Copiază acest fișier în `.env.local` și completează valorile din proiectul Supabase.
# Aplicația pornește și fără aceste valori (schelet #1); sunt necesare abia la #44.
# În Next.js, variabilele expuse în browser au prefixul NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SECRET — doar pe server (Server Actions din backend/). NU are prefix NEXT_PUBLIC_
# și nu trebuie să ajungă niciodată în browser sau în repo. Din Supabase: Settings → API.
SUPABASE_SERVICE_ROLE_KEY=
